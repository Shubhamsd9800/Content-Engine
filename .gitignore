*.tmp
.DS_Store
Thumbs.db
node_modules/

# ---- added by daily-push ----

# Private-by-location. Put anything with real contact details in here and it never reaches git. This is the safe place, by convention.
private/
_local/
**/private/
**/_local/

# Known client-research filenames. Exact names, not topic words -- a wildcard on words like 'outreach' or 'leads' hides real working files.
*client-brief.md
client-candidates-*.md
seed-data.md

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
*_rsa
credentials.json
token.json
*.pfx

# Machine noise
__pycache__/
*.py[cod]
.venv/
venv/
desktop.ini
Scheduled/
.fuse_hidden*
*.lock
!package-lock.json

# Large or regenerable artifacts -- rebuild these, do not version them.
*.zip
brand/proof/
dist/
build/
.pytest_cache/

# Superseded drafts, old backups and downloaded junk. Held on disk because this mount
# cannot delete; excluded from git so dead content never enters history. Nothing here is
# deleted -- empty it from Explorer whenever you want.
archive/
_to_delete/

# Installers and logs -- never versioned.
*.exe
*.log

# Paid-tool leftovers, Day 29. The `belt` CLI renderer behind the marketplace carousel
# skill is PAID and was abandoned on Day 28 -- no dollar spent, and the carousel now has a
# different route (Shubham's own prompt, run in a Claude Desktop project where fonts load).
# NOT the whole .agents/ folder -- that is where real project-scoped skills would live and
# they SHOULD be tracked. Only the dead install is excluded.
.agents/skills/belt/
skills-lock.json

# Same dead belt install, found again under .claude/ on day 29. Garbage, never used.
.claude/skills/belt/
